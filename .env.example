# LeaveLight - konfigurasi bersama HP dan laptop.
# Salin file ini ke .env lalu isi nilai sebenarnya. JANGAN commit .env.

# MQTT broker (Public HiveMQ Broker - gratis & tanpa username/password)
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=

# Topik dan identitas
PROJECT_ID=projek1
DEVICE_ID=leavelight_phone01

# Pemantauan
INTERVAL_S=10
LUX_THRESHOLD=150
SOUND_THRESHOLD=0.05
CONFIRMATION_WINDOW=3
DATA_TIMEOUT_S=30
SCHEDULE_START=17:30
SCHEDULE_END=22:00

# Nama sensor cahaya dari output `termux-sensor -l` (beda antar HP)
LIGHT_SENSOR_NAME=
